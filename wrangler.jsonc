// Cloudflare Workers Builds config: static assets only.
// No "main" script on purpose → no Worker code runs, so requests are plain static-asset serving
// (keep it that way to avoid any usage-based billing). Name must match the Worker in the dashboard.
{
  "name": "game-lab",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist" },
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `npx wrangler preview`, which requires this block (it may stay empty).
  "previews": {}
}
