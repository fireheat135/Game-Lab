{
  "name": "game-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:tools": "python3 -m unittest discover -s tools -p 'test_*.py'",
    "sim": "SIM_REPORT=1 vitest run tests/balance.test.ts --silent=false",
    "sim:abyss": "SIM_REPORT=1 vitest run tests/abyss-balance.test.ts --silent=false"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
